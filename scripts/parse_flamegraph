#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="$(mktemp -d "$PROJECT_DIR/target/profiling/parse_flamegraph.XXXXXX")"
OUT="$BUILD_DIR/parse_flamegraph"
trap 'rm -rf "$BUILD_DIR"' EXIT

mkdir -p "$PROJECT_DIR/target/profiling"
rustc "$SCRIPT_DIR/parse_flamegraph.rs" -O -o "$OUT"
"$OUT" "$@"
